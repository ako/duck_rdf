# name: test/known_bugs/iri_pushdown.test
# description: KNOWN PERFORMANCE BUG - a constant IRI in a pattern becomes
#   CAST(company_id AS VARCHAR) = '1'. DuckDB cannot push that into a Postgres
#   scan (whole table copied, 582 ms vs 6 ms) or use Parquet/Iceberg min-max
#   statistics (88 MB vs 8.8 MB read). It should compare the key column directly.
# group: [known_bugs]

require rdf

statement ok
CREATE TABLE emp AS SELECT * FROM (VALUES (10, 'Ann', 1, 52000)) t(id, name, company_id, salary);

statement ok
CREATE TABLE company AS SELECT * FROM (VALUES (1, 'Acme')) t(id, name);

statement ok
CREATE TABLE payment AS SELECT * FROM (VALUES (1, 0.10::DECIMAL(10,2))) t(id, amount);

# Constant IRI: expect a plain key comparison on the integer column
query T
SELECT regexp_matches(sparql_to_sql('PREFIX ex: <http://example.com/ns#> SELECT ?p WHERE { ?p ex:worksFor <http://data.example.com/company/1> }', 'test/known_bugs/hr_only.ttl'), '"company_id"\s*=\s*1\b');
----
true
