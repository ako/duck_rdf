# name: test/known_bugs/numeric_pushdown.test
# description: KNOWN PERFORMANCE BUG - a numeric FILTER becomes
#   TRY_CAST(CAST(salary AS VARCHAR) AS DOUBLE) > 50000, which cannot be pushed
#   into Postgres or Parquet/Iceberg scans. It should compare the column directly.
# group: [known_bugs]

require rdf

statement ok
CREATE TABLE emp AS SELECT * FROM (VALUES (10, 'Ann', 1, 52000)) t(id, name, company_id, salary);

statement ok
CREATE TABLE company AS SELECT * FROM (VALUES (1, 'Acme')) t(id, name);

statement ok
CREATE TABLE payment AS SELECT * FROM (VALUES (1, 0.10::DECIMAL(10,2))) t(id, amount);

# Numeric FILTER: expect a comparison on the column, without a text round trip
query T
SELECT regexp_matches(sparql_to_sql('PREFIX ex: <http://example.com/ns#> SELECT ?p WHERE { ?p ex:salary ?s FILTER(?s > 50000) }', 'test/known_bugs/hr_only.ttl'), '"salary"\s*>\s*50000');
----
true
