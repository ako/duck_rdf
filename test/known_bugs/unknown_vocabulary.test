# name: test/known_bugs/unknown_vocabulary.test
# description: KNOWN BUG - a class or property that no mapping can produce is
#   accepted and the query silently returns zero rows. It should be an error
#   (ideally naming the closest known term), because a typo is otherwise
#   indistinguishable from "no data" - dangerous for agents.
# group: [known_bugs]

require rdf

statement ok
CREATE TABLE emp AS SELECT * FROM (VALUES (10, 'Ann', 1, 52000)) t(id, name, company_id, salary);

statement ok
CREATE TABLE company AS SELECT * FROM (VALUES (1, 'Acme')) t(id, name);

statement ok
CREATE TABLE payment AS SELECT * FROM (VALUES (1, 0.10::DECIMAL(10,2))) t(id, amount);

# Misspelled property ex:nmae
statement error
SELECT * FROM execute_sparql('PREFIX ex: <http://example.com/ns#> SELECT ?p ?n WHERE { ?p ex:nmae ?n }', 'test/regression/hr_only.ttl');
----

# Misspelled class ex:Employe
statement error
SELECT * FROM execute_sparql('PREFIX ex: <http://example.com/ns#> SELECT ?p WHERE { ?p a ex:Employe }', 'test/regression/hr_only.ttl');
----
