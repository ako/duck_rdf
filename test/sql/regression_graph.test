# name: test/sql/regression_graph.test
# description: SPARQL over a native table, a Parquet view and an ontology loaded with read_rdf.
#   Every query here returned the same result set on AnzoGraph 3.5.0 (differential test,
#   see ako/DuckDbRdfTest). Generated by scripts/gen_regression_tests.py; edit the generator, not this file.
# group: [sql]

require rdf

require parquet

statement ok
CREATE TABLE emp AS SELECT * FROM (VALUES (10, 'Ann', 1, 52000), (11, 'Bob', 2, 61000), (12, 'Cid', 1, 48000), (13, 'Dee', NULL, 70000)) t(id, name, company_id, salary);

statement ok
CREATE TABLE company_src AS SELECT * FROM (VALUES (1, 'Acme'), (2, 'Globex'), (3, 'Initech')) t(id, name);

statement ok
COPY company_src TO '{TEST_DIR}/regression_company.parquet' (FORMAT parquet);

statement ok
CREATE VIEW company AS SELECT * FROM '{TEST_DIR}/regression_company.parquet';

statement ok
CREATE TABLE onto AS SELECT * FROM read_rdf('test/regression/ontology.ttl', prefix_expansion = true);

statement ok
CREATE VIEW onto_iri AS SELECT subject, predicate, object FROM onto WHERE object LIKE 'http%';

statement ok
CREATE VIEW onto_lit AS SELECT subject, predicate, object FROM onto WHERE object NOT LIKE 'http%';

# Join across a native table and a Parquet view
query TT rowsort
SELECT * FROM execute_sparql('PREFIX ex: <http://example.com/ns#> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> SELECT ?e ?c WHERE { ?p ex:name ?e ; ex:worksFor ?co . ?co ex:name ?c }', 'test/regression/hr_mapping.ttl')
----
Ann	Acme
Bob	Globex
Cid	Acme

# OPTIONAL keeps the employee without a company
query TT rowsort
SELECT * FROM execute_sparql('PREFIX ex: <http://example.com/ns#> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> SELECT ?e ?c WHERE { ?p a ex:Employee ; ex:name ?e OPTIONAL { ?p ex:worksFor/ex:name ?c } }', 'test/regression/hr_mapping.ttl')
----
Ann	Acme
Bob	Globex
Cid	Acme
Dee	NULL

# UNION over two classes
query T rowsort
SELECT * FROM execute_sparql('PREFIX ex: <http://example.com/ns#> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> SELECT ?n WHERE { { ?x a ex:Employee ; ex:name ?n } UNION { ?x a ex:Company ; ex:name ?n } }', 'test/regression/hr_mapping.ttl')
----
Acme
Ann
Bob
Cid
Dee
Globex
Initech

# Numeric FILTER on an xsd:integer column
query T rowsort
SELECT * FROM execute_sparql('PREFIX ex: <http://example.com/ns#> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> SELECT ?e WHERE { ?p ex:name ?e ; ex:salary ?s FILTER(?s > 50000) }', 'test/regression/hr_mapping.ttl')
----
Ann
Bob
Dee

# String functions in FILTER
query T rowsort
SELECT * FROM execute_sparql('PREFIX ex: <http://example.com/ns#> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> SELECT ?e WHERE { ?p a ex:Employee ; ex:name ?e FILTER(STRSTARTS(LCASE(?e), "a") || CONTAINS(?e, "e")) }', 'test/regression/hr_mapping.ttl')
----
Ann
Dee

# COUNT with GROUP BY through a property path
query TT rowsort
SELECT * FROM execute_sparql('PREFIX ex: <http://example.com/ns#> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> SELECT ?c (COUNT(?p) AS ?n) WHERE { ?p ex:worksFor/ex:name ?c } GROUP BY ?c', 'test/regression/hr_mapping.ttl')
----
Acme	2
Globex	1

# MIN and MAX
query TT rowsort
SELECT * FROM execute_sparql('PREFIX ex: <http://example.com/ns#> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> SELECT (MIN(?s) AS ?lo) (MAX(?s) AS ?hi) WHERE { ?p ex:salary ?s }', 'test/regression/hr_mapping.ttl')
----
48000	70000

# ORDER BY DESC with LIMIT
query TT
SELECT * FROM execute_sparql('PREFIX ex: <http://example.com/ns#> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> SELECT ?e ?s WHERE { ?p ex:name ?e ; ex:salary ?s } ORDER BY DESC(?s) LIMIT 2', 'test/regression/hr_mapping.ttl')
----
Dee	70000
Bob	61000

# FILTER NOT EXISTS
query T rowsort
SELECT * FROM execute_sparql('PREFIX ex: <http://example.com/ns#> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> SELECT ?c WHERE { ?co a ex:Company ; ex:name ?c FILTER NOT EXISTS { ?p ex:worksFor ?co } }', 'test/regression/hr_mapping.ttl')
----
Initech

# MINUS
query T rowsort
SELECT * FROM execute_sparql('PREFIX ex: <http://example.com/ns#> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> SELECT ?c WHERE { ?co a ex:Company ; ex:name ?c MINUS { ?p ex:worksFor ?co } }', 'test/regression/hr_mapping.ttl')
----
Initech

# BIND with CONCAT and STR
query T rowsort
SELECT * FROM execute_sparql('PREFIX ex: <http://example.com/ns#> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> SELECT ?label WHERE { ?p a ex:Employee ; ex:name ?e ; ex:salary ?s BIND(CONCAT(?e, ":", STR(?s)) AS ?label) }', 'test/regression/hr_mapping.ttl')
----
Ann:52000
Bob:61000
Cid:48000
Dee:70000

# VALUES
query T rowsort
SELECT * FROM execute_sparql('PREFIX ex: <http://example.com/ns#> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> SELECT ?e WHERE { VALUES ?e { "Ann" "Dee" "Zed" } ?p ex:name ?e }', 'test/regression/hr_mapping.ttl')
----
Ann
Dee

# Subclass reasoning with rdfs:subClassOf*
query TT rowsort
SELECT * FROM execute_sparql('PREFIX ex: <http://example.com/ns#> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> SELECT ?n ?t WHERE { ?x a ?t ; ex:name ?n . ?t rdfs:subClassOf* ex:Party }', 'test/regression/hr_mapping.ttl')
----
Acme	http://example.com/ns#Company
Ann	http://example.com/ns#Employee
Bob	http://example.com/ns#Employee
Cid	http://example.com/ns#Employee
Dee	http://example.com/ns#Employee
Globex	http://example.com/ns#Company
Initech	http://example.com/ns#Company

# Domain-based reasoning: sequence path ending in a closure
query T rowsort
SELECT * FROM execute_sparql('PREFIX ex: <http://example.com/ns#> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> SELECT DISTINCT ?x WHERE { ?x ?p ?v . ?p rdfs:domain/rdfs:subClassOf* ex:Party }', 'test/regression/hr_mapping.ttl')
----
http://data.example.com/company/1
http://data.example.com/company/2
http://data.example.com/company/3
http://data.example.com/person/10
http://data.example.com/person/11
http://data.example.com/person/12
http://data.example.com/person/13

# Ontology labels joined to data
query TT rowsort
SELECT * FROM execute_sparql('PREFIX ex: <http://example.com/ns#> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> SELECT ?n ?l WHERE { ?x a ?t ; ex:name ?n . ?t rdfs:label ?l }', 'test/regression/hr_mapping.ttl')
----
Acme	Company
Ann	Employee
Bob	Employee
Cid	Employee
Dee	Employee
Globex	Company
Initech	Company

# Variable predicate on one subject
query TT rowsort
SELECT * FROM execute_sparql('PREFIX ex: <http://example.com/ns#> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> SELECT ?p ?o WHERE { <http://data.example.com/person/10> ?p ?o }', 'test/regression/hr_mapping.ttl')
----
http://example.com/ns#name	Ann
http://example.com/ns#salary	52000
http://example.com/ns#worksFor	http://data.example.com/company/1
http://www.w3.org/1999/02/22-rdf-syntax-ns#type	http://example.com/ns#Employee

# DATATYPE() reports the mapped datatype
query TT rowsort
SELECT * FROM execute_sparql('PREFIX ex: <http://example.com/ns#> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> SELECT ?e (DATATYPE(?s) AS ?dt) WHERE { ?p ex:name ?e ; ex:salary ?s }', 'test/regression/hr_mapping.ttl')
----
Ann	http://www.w3.org/2001/XMLSchema#integer
Bob	http://www.w3.org/2001/XMLSchema#integer
Cid	http://www.w3.org/2001/XMLSchema#integer
Dee	http://www.w3.org/2001/XMLSchema#integer

# isIRI() separates links from values
query TT rowsort
SELECT * FROM execute_sparql('PREFIX ex: <http://example.com/ns#> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> SELECT ?o (isIRI(?o) AS ?iri) WHERE { <http://data.example.com/person/11> ?p ?o }', 'test/regression/hr_mapping.ttl')
----
61000	false
Bob	false
http://data.example.com/company/2	true
http://example.com/ns#Employee	true

# ASK
query T
SELECT * FROM execute_sparql('PREFIX ex: <http://example.com/ns#> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> ASK { ?p ex:name "Bob" }', 'test/regression/hr_mapping.ttl')
----
true
