# name: test/sql/yarrrml_type_iri.test
# description: REGRESSION (fixed in sql2rdf f688cd9) - the YARRRML long form `o: {value: $(col), type: iri}` is
#   ignored when the value is a plain column reference: the object becomes a
#   string literal, so a join on it silently returns no rows. The short form
#   `$(col)~iri` and R2RML `rr:termType rr:IRI` work.
# group: [sql]

require rdf

statement ok
CREATE TABLE link AS SELECT * FROM (VALUES (10, 'http://data.example.com/company/1')) t(id, target);

statement ok
CREATE TABLE company AS SELECT * FROM (VALUES (1, 'Acme')) t(id, name);

query TT
SELECT * FROM execute_sparql('PREFIX ex: <http://example.com/ns#> SELECT ?p ?n WHERE { ?p ex:worksFor ?c . ?c ex:name ?n }', 'test/regression/link_column.yml');
----
http://data.example.com/person/10	Acme
