#include <vector>

namespace dgl {
inline const std::vector<std::pair<const char *, const char *>> &GuideSources() {
	static const std::vector<std::pair<const char *, const char *>> topics {
@GUIDE_ENTRIES@	};
	return topics;
}
} // namespace dgl
